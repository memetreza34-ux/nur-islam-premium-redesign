{"number":112,"name":"سُورَةُ الإِخۡلَاصِ","englishName":"Al-Ikhlaas","englishNameTranslation":"Sincerity","numberOfAyahs":4,"revelationType":"Meccan","ayahs":[{"numberInSurah":1,"text":"Sprich: \"Er ist Allah, ein Einziger"},{"numberInSurah":2,"text":"Allah, der Absolute (ewig Unabhängige, von Dem alles abhängt)."},{"numberInSurah":3,"text":"Er zeugt nicht und ist nicht gezeugt worden"},{"numberInSurah":4,"text":"und Ihm ebenbürtig ist keiner.\""}]}