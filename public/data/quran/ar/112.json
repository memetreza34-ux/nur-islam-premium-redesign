{"number":112,"name":"سُورَةُ الإِخۡلَاصِ","englishName":"Al-Ikhlaas","englishNameTranslation":"Sincerity","numberOfAyahs":4,"revelationType":"Meccan","ayahs":[{"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ"},{"numberInSurah":2,"text":"ٱللَّهُ ٱلصَّمَدُ"},{"numberInSurah":3,"text":"لَمْ يَلِدْ وَلَمْ يُولَدْ"},{"numberInSurah":4,"text":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ"}]}