{"number":77,"name":"سُورَةُ المُرۡسَلَاتِ","englishName":"Al-Mursalaat","englishNameTranslation":"The Emissaries","numberOfAyahs":50,"revelationType":"Meccan","ayahs":[{"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَٰتِ عُرْفًۭا"},{"numberInSurah":2,"text":"فَٱلْعَٰصِفَٰتِ عَصْفًۭا"},{"numberInSurah":3,"text":"وَٱلنَّٰشِرَٰتِ نَشْرًۭا"},{"numberInSurah":4,"text":"فَٱلْفَٰرِقَٰتِ فَرْقًۭا"},{"numberInSurah":5,"text":"فَٱلْمُلْقِيَٰتِ ذِكْرًا"},{"numberInSurah":6,"text":"عُذْرًا أَوْ نُذْرًا"},{"numberInSurah":7,"text":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٌۭ"},{"numberInSurah":8,"text":"فَإِذَا ٱلنُّجُومُ طُمِسَتْ"},{"numberInSurah":9,"text":"وَإِذَا ٱلسَّمَآءُ فُرِجَتْ"},{"numberInSurah":10,"text":"وَإِذَا ٱلْجِبَالُ نُسِفَتْ"},{"numberInSurah":11,"text":"وَإِذَا ٱلرُّسُلُ أُقِّتَتْ"},{"numberInSurah":12,"text":"لِأَىِّ يَوْمٍ أُجِّلَتْ"},{"numberInSurah":13,"text":"لِيَوْمِ ٱلْفَصْلِ"},{"numberInSurah":14,"text":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ"},{"numberInSurah":15,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"},{"numberInSurah":16,"text":"أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ"},{"numberInSurah":17,"text":"ثُمَّ نُتْبِعُهُمُ ٱلْءَاخِرِينَ"},{"numberInSurah":18,"text":"كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ"},{"numberInSurah":19,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"},{"numberInSurah":20,"text":"أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ"},{"numberInSurah":21,"text":"فَجَعَلْنَٰهُ فِى قَرَارٍۢ مَّكِينٍ"},{"numberInSurah":22,"text":"إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ"},{"numberInSurah":23,"text":"فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ"},{"numberInSurah":24,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"},{"numberInSurah":25,"text":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا"},{"numberInSurah":26,"text":"أَحْيَآءًۭ وَأَمْوَٰتًۭا"},{"numberInSurah":27,"text":"وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍۢ وَأَسْقَيْنَٰكُم مَّآءًۭ فُرَاتًۭا"},{"numberInSurah":28,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"},{"numberInSurah":29,"text":"ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُ