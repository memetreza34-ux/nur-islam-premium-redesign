{"number":114,"name":"سُورَةُ النَّاسِ","englishName":"An-Naas","englishNameTranslation":"Mankind","numberOfAyahs":6,"revelationType":"Meccan","ayahs":[{"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ"},{"numberInSurah":2,"text":"مَلِكِ ٱلنَّاسِ"},{"numberInSurah":3,"text":"إِلَٰهِ ٱلنَّاسِ"},{"numberInSurah":4,"text":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ"},{"numberInSurah":5,"text":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ"},{"numberInSurah":6,"text":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ"}]}