{"number":108,"name":"سُورَةُ الكَوۡثَرِ","englishName":"Al-Kawthar","englishNameTranslation":"Abundance","numberOfAyahs":3,"revelationType":"Meccan","ayahs":[{"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ"},{"numberInSurah":2,"text":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ"},{"numberInSurah":3,"text":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ"}]}