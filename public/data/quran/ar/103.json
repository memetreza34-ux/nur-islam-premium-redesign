{"number":103,"name":"سُورَةُ العَصۡرِ","englishName":"Al-Asr","englishNameTranslation":"The Declining Day, Epoch","numberOfAyahs":3,"revelationType":"Meccan","ayahs":[{"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَصْرِ"},{"numberInSurah":2,"text":"إِنَّ ٱلْإِنسَٰنَ لَفِى خُسْرٍ"},{"numberInSurah":3,"text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ"}]}