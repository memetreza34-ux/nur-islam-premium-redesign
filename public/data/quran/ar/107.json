{"number":107,"name":"سُورَةُ المَاعُونِ","englishName":"Al-Maa'un","englishNameTranslation":"Almsgiving","numberOfAyahs":7,"revelationType":"Meccan","ayahs":[{"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ"},{"numberInSurah":2,"text":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ"},{"numberInSurah":3,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"},{"numberInSurah":4,"text":"فَوَيْلٌۭ لِّلْمُصَلِّينَ"},{"numberInSurah":5,"text":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ"},{"numberInSurah":6,"text":"ٱلَّذِينَ هُمْ يُرَآءُونَ"},{"numberInSurah":7,"text":"وَيَمْنَعُونَ ٱلْمَاعُونَ"}]}