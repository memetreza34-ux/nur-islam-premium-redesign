{"number":70,"name":"سُورَةُ المَعَارِجِ","englishName":"Al-Ma'aarij","englishNameTranslation":"The Ascending Stairways","numberOfAyahs":44,"revelationType":"Meccan","ayahs":[{"numberInSurah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَأَلَ سَآئِلٌۢ بِعَذَابٍۢ وَاقِعٍۢ"},{"numberInSurah":2,"text":"لِّلْكَٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌۭ"},{"numberInSurah":3,"text":"مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ"},{"numberInSurah":4,"text":"تَعْرُجُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍۢ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍۢ"},{"numberInSurah":5,"text":"فَٱصْبِرْ صَبْرًۭا جَمِيلًا"},{"numberInSurah":6,"text":"إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًۭا"},{"numberInSurah":7,"text":"وَنَرَىٰهُ قَرِيبًۭا"},{"numberInSurah":8,"text":"يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ"},{"numberInSurah":9,"text":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ"},{"numberInSurah":10,"text":"وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًۭا"},{"numberInSurah":11,"text":"يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ"},{"numberInSurah":12,"text":"وَصَٰحِبَتِهِۦ وَأَخِيهِ"},{"numberInSurah":13,"text":"وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ"},{"numberInSurah":14,"text":"وَمَن فِى ٱلْأَرْضِ جَمِيعًۭا ثُمَّ يُنجِيهِ"},{"numberInSurah":15,"text":"كَلَّآ ۖ إِنَّهَا لَظَىٰ"},{"numberInSurah":16,"text":"نَزَّاعَةًۭ لِّلشَّوَىٰ"},{"numberInSurah":17,"text":"تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ"},{"numberInSurah":18,"text":"وَجَمَعَ فَأَوْعَىٰٓ"},{"numberInSurah":19,"text":"۞ إِنَّ ٱلْإِنسَٰنَ خُلِقَ هَلُوعًا"},{"numberInSurah":20,"text":"إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًۭا"},{"numberInSurah":21,"text":"وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا"},{"numberInSurah":22,"text":"إِلَّا ٱلْمُصَلِّينَ"},{"numberInSurah":23,"text":"ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ"},{"numberInSurah":24,"text":"وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّۭ مَّعْلُومٌۭ"},{"numberInSurah":25,"text":"لِّلسَّآئِلِ وَٱلْمَحْرُومِ"},{"numberInSurah":26,"text":"وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ"},{"numberInSurah":27,"text":"وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ"},{"numberInSurah":28,"text":"إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍۢ"},{"numberInSurah":29,"text":"وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ"},{"numberInSurah":30,"text":"إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ"},{"numberInSurah":31,"text":"فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَٰٓئِكَ هُمُ ٱلْعَادُونَ"},{"numberInSurah":32,"text":"وَٱلَّذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ"},{"numberInSurah":33,"text":"وَٱلَّذِينَ هُم بِشَهَٰدَٰتِهِمْ قَآئِمُونَ"},{"numberInSurah":34,"text":"وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ"},{"numberInSurah":35,"text":"أُو۟لَٰٓئِكَ فِى جَنَّٰتٍۢ مُّكْرَمُونَ"},{"numberInSurah":36,"text":"فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ"},{"numberInSurah":37,"text":"عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ"},{"numberInSurah":38,"text":"أَيَطْمَعُ كُلُّ ٱمْرِئٍۢ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍۢ"},{"numberInSurah":39,"text":"كَلَّآ ۖ إِنَّا خَلَقْنَٰهُم مِّمَّا يَعْلَمُونَ"},{"numberInSurah":40,"text":"فَلَآ أُقْسِمُ بِرَبِّ ٱلْمَشَٰرِقِ وَٱلْمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ"},{"numberInSurah":41,"text":"عَلَىٰٓ أَن نُّبَدِّلَ خَيْرًۭا مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَ"},{"numberInSurah":42,"text":"فَذَرْهُمْ يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ يُلَٰقُوا۟ يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ"},{"numberInSurah":43,"text":"يَوْمَ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ سِرَاعًۭا كَأَنَّهُمْ إِلَىٰ نُصُبٍۢ يُوفِضُونَ"},{"numberInSurah":44,"text":"خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌۭ ۚ ذَٰلِكَ ٱلْيَوْمُ ٱلَّذِى كَانُوا۟ يُوعَدُونَ"}]}